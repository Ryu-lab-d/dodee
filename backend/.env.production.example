# Environment variables to set in Railway's dashboard for the backend service.
# Do NOT commit real secrets - this file is just a reference of what to fill in.

NODE_ENV=production
PORT=4000

# Railway's Postgres plugin gives you this automatically - just reference it as a
# "variable reference" in Railway's dashboard (${{Postgres.DATABASE_URL}}), no need to
# type it manually.
DATABASE_URL=

# Auth - generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# A ready-to-use one was generated for you during setup - see the deployment guide/chat.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Billing defaults
DEFAULT_WATER_RATE=50
DEFAULT_ELECTRICITY_RATE=7
INVOICE_DUE_DAYS=10

# The real Vercel URL of the frontend once deployed (used for CORS + links inside LINE messages)
FRONTEND_URL=https://your-app.vercel.app

# LINE OA credentials are entered through the app's own Settings page (stored in the
# database), not as env vars - no need to set these here.
