NODE_ENV=development
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dodee
DB_USER=postgres
DB_PASSWORD=postgres

# Auth
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# Billing defaults (baht/unit) - overridable per property later in Settings module
DEFAULT_WATER_RATE=50
DEFAULT_ELECTRICITY_RATE=7
INVOICE_DUE_DAYS=10

# --- Stubbed integrations (Phase 2) ---
# OCR_PROVIDER=tesseract|google-vision
# LINE_CHANNEL_ACCESS_TOKEN=

# Public URL of the frontend, used for links inside LINE messages (e.g. meeting minute buttons)
FRONTEND_URL=http://localhost:3000
